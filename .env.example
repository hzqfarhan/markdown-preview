# ==============================================================================
# Markdown Previewer PWA — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Providers for Text-to-Markdown Refinement
# ------------------------------------------------------------------------------
# You only need AT LEAST ONE of these keys for AI refinement to work!
# If none are provided, the app will use its built-in offline heuristic formatter.

# Google Gemini (Recommended — fast & generous free tier):
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI:
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude:
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 2. Google OAuth (Optional — for Google Docs export & cloud account sync)
# ------------------------------------------------------------------------------
# Configure OAuth 2.0 Client ID in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/google/auth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/auth
